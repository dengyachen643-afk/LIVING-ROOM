# Server (local-only by default)
PORT=8787
HOST=127.0.0.1

# Set true for direct phone access without a separate site password.
ROUNDTABLE_PUBLIC_ACCESS=false
# Used only while public access is false.
ROUNDTABLE_ACCESS_TOKEN=
ROUNDTABLE_STATE_FILE=.roundtable/state.json

# Separate, memory-only Bearer token for a private Custom GPT Action.
# Do not reuse the roundtable token. Set this before exposing the service.
GPT_MEMORY_TOKEN=

# Optional stable HTTPS address used in /openapi.json, for example:
# PUBLIC_BASE_URL=https://your-computer.your-tailnet.ts.net
PUBLIC_BASE_URL=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=medium

# Kimi API
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_PRIVATE_MODEL=kimi-k3
KIMI_PRIVATE_MAX_TOKENS=2400
KIMI_TEMPERATURE=1
KIMI_TOP_P=0.95
KIMI_TOOLS_ENABLED=true
UPLOAD_DIR=.roundtable/uploads
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_KEY_FILE=.roundtable/kimi-api-key.txt
GEN_PRIVATE_ENABLED=false
GEN_PRIVATE_COMMAND=codex
GEN_PRIVATE_MODEL=gpt-5.6-sol
GEN_REASONING_EFFORT=medium
GEN_RUNTIME_DIR=.roundtable/gen-runtime
GEN_TIMEOUT_SECONDS=180
HF_ENDPOINT=https://hf-mirror.com
MEMORY_VECTOR_ENABLED=true
KIMI_AUTO_MEMORY=true
MEMORY_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_MODEL_CACHE=.roundtable/models

# Claude API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude Code CLI (optional, uses your local Claude login)
# Kept off until you explicitly opt in. Chat mode disables all tools.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=opus

# Codex CLI fallback (experimental, uses your local Codex login)
CODEX_CLI_ENABLED=false
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=

# Per-speaker generation guardrails
MODEL_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=1600
