# Server (local-only by default)
PORT=8787
HOST=127.0.0.1

# Set true for direct phone access without a separate site password.
ROUNDTABLE_PUBLIC_ACCESS=false
# Used only while public access is false.
ROUNDTABLE_ACCESS_TOKEN=
ROUNDTABLE_STATE_FILE=.roundtable/state.json

# Separate, memory-only Bearer token for a private Custom GPT Action.
# Do not reuse the roundtable token. Set this before exposing the service.
GPT_MEMORY_TOKEN=

# Optional stable HTTPS address used in /openapi.json, for example:
# PUBLIC_BASE_URL=https://your-computer.your-tailnet.ts.net
PUBLIC_BASE_URL=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=medium

# Kimi API
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_PRIVATE_MODEL=kimi-k2.5
KIMI_REASONING_EFFORT=medium
KIMI_TEMPERATURE=1
KIMI_TOP_P=0.95
KIMI_TOOLS_ENABLED=true
UPLOAD_DIR=.roundtable/uploads
CHAT_HISTORY_DB_FILE=.roundtable/chat-history.sqlite
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_KEY_FILE=.roundtable/kimi-api-key.txt

# GLM private chat (text uses GLM-5.1; image turns use GLM-5V-Turbo)
GLM_API_KEY=
GLM_PRIVATE_ENABLED=true
GLM_MODEL=glm-5.1
GLM_VISION_MODEL=glm-5v-turbo
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_KEY_FILE=.roundtable/glm-api-key.txt
GLM_TIMEOUT_SECONDS=300
GEN_PRIVATE_ENABLED=false
GEN_PRIVATE_COMMAND=codex
GEN_PRIVATE_MODEL=gpt-5.6-sol
GEN_REASONING_EFFORT=medium
GEN_WORK_REASONING_EFFORT=high
GEN_WINDOWS_SANDBOX=unelevated
GEN_RUNTIME_DIR=.roundtable/gen-runtime
GEN_TIMEOUT_SECONDS=600
# Gen private chat stays read-only by default. Work mode may write only inside
# these two server-controlled directories; the browser cannot submit a path.
GEN_WORK_ENABLED=false
GEN_PROJECT_DIR=
GEN_WORKSPACE_DIR=
HF_ENDPOINT=https://hf-mirror.com
MEMORY_VECTOR_ENABLED=true
KIMI_AUTO_MEMORY=true
GLM_AUTO_MEMORY=true
GROUP_AUTO_MEMORY=true
KIMI_MEMORY_MODEL=moonshot-v1-8k
GLM_MEMORY_MODEL=glm-5.1
KIMI_MEMORY_BATCH_SIZE=6
GLM_MEMORY_BATCH_SIZE=6
GROUP_MEMORY_BATCH_SIZE=4
MEMORY_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_MODEL_CACHE=.roundtable/models

# Claude API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude Code CLI (optional, uses your local Claude login)
# Kept off until you explicitly opt in. Chat mode disables all tools.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=opus

# Codex CLI fallback (experimental, uses your local Codex login)
CODEX_CLI_ENABLED=false
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=

# Per-speaker generation guardrails
MODEL_TIMEOUT_SECONDS=120
KIMI_TIMEOUT_SECONDS=300
MAX_OUTPUT_TOKENS=1600

# Independent proactive wake-ups. Each available member decides whether to
# skip, send to its own private chat (Gen/Kimi/Shin), or send to the room
# (members without a private channel can only choose the room).
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MINUTES=60
PROACTIVE_STAGGER_MINUTES=5
PROACTIVE_TIMEOUT_SECONDS=120
PROACTIVE_QUIET_START=00:00
PROACTIVE_QUIET_END=08:00
PROACTIVE_TIME_ZONE=Asia/Shanghai
# Optional comma-separated provider IDs, for example: codex-cli,kimi,anthropic
PROACTIVE_MEMBER_IDS=
PROACTIVE_MAX_BACKOFF_MINUTES=360

# Moments / 朋友圈. Each available member gets three all-day candidate slots
# and may choose to post or skip. Data is stored separately in SQLite.
MOMENTS_ENABLED=true
MOMENTS_DB_FILE=.roundtable/moments.sqlite
MOMENTS_SLOTS_PER_DAY=3
MOMENTS_TICK_SECONDS=30
MOMENTS_IMAGE_ENABLED=true
MOMENTS_IMAGE_MODEL=cogview-4-250304
