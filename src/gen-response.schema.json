{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "memoryActions"],
  "properties": {
    "reply": {
      "type": "string"
    },
    "memoryActions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "text", "tags", "importance", "reason"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create", "update", "delete"]
          },
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
